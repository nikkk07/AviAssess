# ── JWT verification (scoring service) ───────────────────────────────
# MUST be the SAME secret value as the auth service that issues tokens,
# otherwise signatures won't verify. No default — the app fails to start
# if this is unset.
JWT_SECRET_KEY=replace-with-the-same-secret-as-the-auth-service
JWT_ALGORITHM=HS256

# ── Results persistence (optional) ────────────────────────────────────
# Supabase POOLER connection string (port 6543, PgBouncer) — NOT direct 5432.
# This service spins down when idle and reconnects on cold start, so it needs
# the pooler. Optional — if unset, the service runs without saving results.
# NEVER commit a real password here; this is a placeholder only.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
