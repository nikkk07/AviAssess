# Copy to .env and adjust as needed.
#
# Which backend the UI calls. Defaults to the live Render service if unset.
# Switch to http://localhost:8000 to develop against a local uvicorn instance.
#
# This is inlined into the browser bundle — it is NOT a secret (just a URL).
# The access TOKEN is never stored here; it's pasted at runtime on the login screen.
VITE_API_BASE_URL=https://aviassess.onrender.com
