# Copy to .env and adjust as needed.
#
# Which backend the UI calls. Defaults to the live Render service if unset.
# Switch to http://localhost:8000 to develop against a local uvicorn instance.
#
# This is inlined into the browser bundle — it is NOT a secret (just a URL).
# The access TOKEN is never stored here; it's pasted at runtime on the login screen.
VITE_API_BASE_URL=https://aviassess.onrender.com

# Phase A2: the user-facing login is disabled. On load the app SILENTLY trades
# this fixed dev code for a real server-minted token (the backend route only
# exists when DEV_LOGIN_ENABLED is set there). Set this to the server's
# DEV_LOGIN_CODE. Without it, the app shows a friendly "sign-in not configured"
# error instead of a session.
VITE_DEV_LOGIN_CODE=123456

# Optional: set to "true" to bring back the legacy paste-token / dev-code login
# screen (kept in the code, gated off by default). Leave unset for normal use.
# VITE_ENABLE_LOGIN=true
