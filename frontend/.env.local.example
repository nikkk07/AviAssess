# Copy to .env.local and adjust as needed.
#
# Which backend the UI calls. Defaults to the live Render service if unset.
# Switch to http://localhost:8000 to develop against a local uvicorn instance.
#
# NOTE: this is a NEXT_PUBLIC_ var, so it is inlined into the browser bundle —
# it is NOT a secret (it's just a URL). The access TOKEN is never stored here;
# it's pasted at runtime into the dev-token field.
NEXT_PUBLIC_API_BASE_URL=https://aviassess.onrender.com
