# ─────────────────────────────────────────────────────────────────────────
# AviAssess scoring service — PRODUCTION environment variables (Render).
#
# This file is a TEMPLATE only. Do NOT put real secret values here and do NOT
# commit real values. In production these are set in the Render dashboard
# (the secret ones are declared `sync: false` in render.yaml).
# ─────────────────────────────────────────────────────────────────────────

# ── Secrets (set in Render dashboard; sync:false; never commit real values) ──

# Signature key for verifying LOGIN access tokens.
# MUST be byte-for-byte identical to the auth service's JWT_SECRET_KEY, or
# tokens minted there will fail verification here.
JWT_SECRET_KEY=copy-the-exact-same-value-as-the-auth-service

# Signature key for THIS service's stateless SESSION tokens.
# MUST be a NEW, distinct random value — different from JWT_SECRET_KEY.
# (config.py refuses to start if SESSION_SECRET == JWT_SECRET_KEY.)
SESSION_SECRET=generate-a-new-random-secret-different-from-jwt-secret-key

# Comma-separated list of allowed browser origins for CORS. Never "*".
# Example: https://aviassess.vercel.app,https://www.aviassess.com
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Comma-separated UUIDs permitted to POST /api/admin/config. May be empty
# (then no one can change config via the API until you add an ID here).
ADMIN_USER_IDS=

# ── Non-secret config (safe to commit; also declared in render.yaml) ──

# JWT signing algorithm — must match the auth service. Default HS256.
JWT_ALGORITHM=HS256

# HuggingFace cache dir. Must be the SAME at build and runtime so the model
# pre-downloaded during the build is reused instead of re-downloaded.
HF_HOME=/opt/render/project/.cache/huggingface

# ── Optional overrides (have sensible defaults in config.py) ──

# Session token lifetime in seconds (default 1800 = 30 min).
# SESSION_TTL_SECONDS=1800

# Paths to the question pool and admin config (local files until R2 in Phase 5).
# QUESTIONS_PATH=tests/fixtures/sample_qa.json
# CONFIG_PATH=config.json
